# Repository-wide. The app and the backend have their own .gitignore.

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.iml
*.swp
.history/

# Local secrets
.env
.env.*
!.env.example

# Python (the media tools in tools/)
.venv/
__pycache__/

# Downloads of the media tools (Fluent Emoji sources, the Kokoro voice model)
tools/illustrations/.cache/
tools/voice/.cache/


# Pictures and recordings of the courses: made by tools/, kept on the
# server (MEDIA_DIR) and served at /media/, never in git or in the app
/media/

# Where the server is (written by terraform; not secret, but per machine)
deploy/server.env
