# Likho on the server: copy to deploy/.env (next to docker-compose.yml) and fill in.
# APP_ENV, PORT, DATABASE_URL, REDIS_URL, MEDIA_DIR and ADMIN_DIR are set by
# docker-compose.yml.

# Where deploy.sh puts the media and the admin panel on the server.
LIKHO_DIR=/srv/likho
# The API's port on 127.0.0.1 (nginx forwards to it). Pick one no other project uses.
LIKHO_PORT=8080

# `openssl rand -base64 24`
POSTGRES_PASSWORD=

# At least 32 random characters: `openssl rand -base64 48`
JWT_SECRET=

# Google OAuth client IDs (iOS, Android, Web), comma separated.
GOOGLE_CLIENT_IDS=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h

# The first admin of the admin panel (created when there is none yet).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Countries of families, if a CDN in front of nginx sets one (e.g. CF-IPCountry).
# COUNTRY_HEADER=
