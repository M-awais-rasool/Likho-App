# deploy/.env on the server. You do not write it: server-setup.sh creates it
# on the first deploy with fresh random secrets, and it never leaves the
# server. This file only shows what is in it.
# APP_ENV, PORT, DATABASE_URL, REDIS_URL, MEDIA_DIR, ADMIN_DIR, GEOIP_DB and
# TRUSTED_PROXIES are set by docker-compose.yml.

LIKHO_DIR=/srv/likho
LIKHO_PORT=8080

POSTGRES_PASSWORD=   # random, 32 characters
REDIS_PASSWORD=      # random, 32 characters
JWT_SECRET=          # random, 64 characters

# Google OAuth client IDs (iOS, Android, Web), comma separated: from
# google_client_ids in terraform.tfvars, kept in step on every deploy.
GOOGLE_CLIENT_IDS=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h

# The first admin of the admin panel (created when there is none yet). The
# password is random and shown once by the first deploy.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Countries of families, if a CDN in front of nginx sets one (e.g. CF-IPCountry).
# COUNTRY_HEADER=
