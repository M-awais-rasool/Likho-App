# Copy to .env and fill in. `make run` loads it.

APP_ENV=development
PORT=8080

DATABASE_URL=postgres://likho:likho@localhost:5432/likho?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# OAuth client IDs from Google Cloud Console (APIs & Services > Credentials),
# comma separated: the iOS client, the Android client and the Web client
# (Android apps send ID tokens for the Web client = serverClientId).
GOOGLE_CLIENT_IDS=1234-ios.apps.googleusercontent.com,1234-web.apps.googleusercontent.com

# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-change-me-change-me-change-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h

# course.json to publish (imported into Postgres when it changes)
COURSE_FILE=../assets/data/course.json

# Development only: sign in with "dev:<email>" instead of a Google token.
# Refused when APP_ENV=production.
DEV_LOGIN=true
