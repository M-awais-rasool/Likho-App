# Copy to .env and fill in. `make run` loads it.

APP_ENV=development
PORT=8080

DATABASE_URL=postgres://likho:likho@localhost:5432/likho?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# OAuth client IDs from Google Cloud Console (APIs & Services > Credentials),
# comma separated: the iOS client, the Android client and the Web client
# (Android apps send ID tokens for the Web client = serverClientId).
GOOGLE_CLIENT_IDS=1234-ios.apps.googleusercontent.com,1234-web.apps.googleusercontent.com

# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-change-me-change-me-change-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h

# Learning content (content/) is built into the binary. To try content
# without a rebuild, point CONTENT_DIR at a content folder (with courses/).
# CONTENT_DIR=./content
# Courses marked "draft" are served in development only (override here).
# CONTENT_DRAFTS=false

# Pictures and recordings of the courses (made by tools/ at the repository
# root, not in git), served at /media/ with their manifest at /v1/media.
MEDIA_DIR=../media
# Connections to Postgres (default: by the number of CPUs, 8 to 20).
# DB_MAX_CONNS=16

# Development only: sign in with "dev:<email>" instead of a Google token.
# Refused when APP_ENV=production.
DEV_LOGIN=true

# Google accounts with Likho Plus and every level open at every sign-in
# (Play's app review). Default: likho.review@gmail.com.
# REVIEW_ACCOUNTS=likho.review@gmail.com

# Admin panel (admin/ in the repo). The first owner is created at start-up
# when there are no admins yet; add the rest of the team in the panel.
ADMIN_BOOTSTRAP_EMAIL=admin@likho.app
ADMIN_BOOTSTRAP_PASSWORD=change-me-please
# Serve the built panel (cd admin && npm run build) at /admin/ from the API.
# ADMIN_DIR=../admin/dist

# Countries of families (admin panel), most trusted first:
# a header your CDN / load balancer sets with the visitor's country…
# COUNTRY_HEADER=CF-IPCountry
# …and/or a GeoIP country database (`make geoip` downloads DB-IP's free one).
# GEOIP_DB=./geoip/country.mmdb
# Without either, the region of the phone's language setting is used.

# Proxies allowed to say who the client is (X-Forwarded-For), as IPs or
# CIDRs, comma separated: the nginx in front of the API. Empty = none, so
# a client can never fake its IP to get around the rate limits.
# deploy/docker-compose.yml sets it in production.
# TRUSTED_PROXIES=127.0.0.1

# Google Play Billing (Likho Plus). Without a service account key, purchases
# answer 503 (with DEV_LOGIN, "dev:monthly" / "dev:yearly" tokens stand in).
# PLAY_SERVICE_ACCOUNT_FILE=/path/to/play-service-account.json
# PLAY_NOTIFY_KEY=a-long-random-string   # the ?key= in the Pub/Sub push URL
# PLAY_PACKAGE_NAME=com.likho.abcwriting
# PLAY_PRODUCT_ID=likho_plus
