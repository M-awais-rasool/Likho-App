{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likho.app/schema/level.schema.json",
  "title": "Level",
  "description": "worlds/<NN-name>/levels/<NN-name>.json (or placement.json): one level and its rounds. The world comes from the folder.",
  "type": "object",
  "required": ["id", "number", "name", "skill", "icon", "isBoss", "requiresSubscription", "intro", "presentation", "rounds"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "number": { "type": "integer", "minimum": 0, "description": "Position on the map, 1..n across the course (0 = placement). Never renumber published levels: progress is stored by number." },
    "name": { "type": "string", "minLength": 1 },
    "skill": { "type": "string" },
    "icon": { "type": "string", "description": "Material Symbols name." },
    "isBoss": { "type": "boolean" },
    "requiresSubscription": { "type": "boolean", "description": "Likho Plus level." },
    "intro": {
      "type": "object",
      "required": ["text", "word", "picture"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "word": { "type": "string" },
        "say": { "$ref": "#/$defs/say", "description": "What Pencil says while the intro shows (e.g. \"B! B is for balloon.\")." },
        "audio": { "$ref": "#/$defs/audio" },
        "picture": { "$ref": "#/$defs/picture" }
      }
    },
    "presentation": {
      "type": "object",
      "description": "How the level looks (keys the app maps to its design).",
      "additionalProperties": false,
      "properties": {
        "shape": { "type": ["string", "null"] },
        "slot": { "type": ["string", "null"] },
        "layout": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] }
      }
    },
    "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/round" } }
  },
  "$defs": {
    "say": {
      "type": "string",
      "minLength": 1,
      "description": "Spoken words. {shown|IPA} gives a pronunciation: the device voice reads `shown`, recordings say the IPA (\"small {a|ˈeɪ}\" = the letter, not the article)."
    },
    "audio": {
      "type": ["string", "null"],
      "pattern": "^([a-z0-9_-]+/)+[A-Za-z0-9_.-]+\\.(m4a|wav|mp3)$|^https?://.+$",
      "description": "Recording of `say` (or `text`): a file in the media folder (voice/line-….m4a, made by tools/voice at the repository root, served at /media/) or a URL. Without it the device voice reads the words."
    },
    "picture": {
      "type": ["object", "null"],
      "required": ["key", "label"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "description": "Image media/pictures/<key>.png (tools/illustrations), served at /media/pictures/<key>.png." },
        "label": { "type": "string" },
        "url": { "type": ["string", "null"], "description": "Remote image instead of a bundled one." }
      }
    },
    "round": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["pick", "write", "order", "speak", "hunt", "fix", "sort", "match", "pop", "truth"], "description": "The payload object has the same name." },
        "prompt": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "say": { "$ref": "#/$defs/say", "description": "What Pencil says when it is not the text on screen (\"/b/\" -> \"Which letter says {/b/|bʌ}?\")." },
            "audio": { "$ref": "#/$defs/audio" }
          }
        },
        "card": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": { "text": { "type": ["string", "null"] }, "picture": { "$ref": "#/$defs/picture" }, "listen": { "type": "boolean" } }
        },
        "pick": { "$ref": "#/$defs/pick" },
        "write": { "$ref": "#/$defs/write" },
        "order": { "$ref": "#/$defs/order" },
        "speak": { "$ref": "#/$defs/speak" },
        "hunt": { "$ref": "#/$defs/hunt" },
        "fix": { "$ref": "#/$defs/fix" },
        "sort": { "$ref": "#/$defs/sort" },
        "match": { "$ref": "#/$defs/match" },
        "pop": { "$ref": "#/$defs/pop" },
        "truth": { "$ref": "#/$defs/truth" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "pick" } } }, "then": { "required": ["pick"] } },
        { "if": { "properties": { "type": { "const": "write" } } }, "then": { "required": ["write"] } },
        { "if": { "properties": { "type": { "const": "order" } } }, "then": { "required": ["order"] } },
        { "if": { "properties": { "type": { "const": "speak" } } }, "then": { "required": ["speak"] } },
        { "if": { "properties": { "type": { "const": "hunt" } } }, "then": { "required": ["hunt"] } },
        { "if": { "properties": { "type": { "const": "fix" } } }, "then": { "required": ["fix"] } },
        { "if": { "properties": { "type": { "const": "sort" } } }, "then": { "required": ["sort"] } },
        { "if": { "properties": { "type": { "const": "match" } } }, "then": { "required": ["match"] } },
        { "if": { "properties": { "type": { "const": "pop" } } }, "then": { "required": ["pop"] } },
        { "if": { "properties": { "type": { "const": "truth" } } }, "then": { "required": ["truth"] } }
      ]
    },
    "pick": {
      "type": "object",
      "required": ["options", "answer"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "picture": { "$ref": "#/$defs/picture" },
              "color": { "enum": ["red", "blue", "yellow", "green", "purple", null] },
              "hideLabel": { "type": "boolean" }
            }
          }
        },
        "answer": {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "enum": ["label", "any"] }, "value": { "type": "string" } }
        },
        "shape": { "type": ["string", "null"] },
        "layout": { "type": ["string", "null"] },
        "count": { "type": ["integer", "null"] },
        "choiceKey": { "type": ["string", "null"], "description": "Story choice this pick fills (My Story)." },
        "stage": { "enum": ["house", "count", "stars", null], "description": "This round's stage instead of the level's presentation.stage." },
        "fixCapital": { "type": "boolean" }
      }
    },
    "write": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["trace", "dots", "free", "flash", "missing", "spell"], "description": "flash: the letter (or word) shows for a moment, then is written from memory." },
        "target": { "type": ["string", "null"] },
        "guide": { "type": ["string", "null"], "description": "Key in glyphs.json." },
        "word": { "type": ["string", "null"] },
        "missingIndex": { "type": ["integer", "null"] },
        "sentence": { "type": "boolean" },
        "story": { "type": "boolean" }
      }
    },
    "order": {
      "type": "object",
      "required": ["tiles"],
      "properties": {
        "tiles": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "slot": { "enum": ["wagon", "plank", "stripe", "panel", null], "description": "This round's slots instead of the level's presentation.slot." }
      }
    },
    "speak": {
      "type": "object",
      "properties": { "expected": { "type": ["string", "null"] } }
    },
    "hunt": {
      "type": "object",
      "description": "Letter hunt: tap every cell that is the target (wrong cells count a mistake).",
      "required": ["target", "grid"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "grid": { "type": "array", "minItems": 4, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "fix": {
      "type": "object",
      "description": "Fix Pencil's mistakes: tap every item written wrong (backwards or upside down); tapping a right one is a mistake.",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "wrong": { "enum": ["mirror", "upside", null], "description": "null = written right." },
              "at": { "type": ["integer", "null"], "description": "The one letter of text that is wrong; null = all of it." }
            }
          }
        }
      }
    },
    "sort": {
      "type": "object",
      "description": "Drag things into bins. One bin = the hungry monster (items without a bin are not its food); two or three = baskets (every item has one).",
      "required": ["bins", "items"],
      "properties": {
        "bins": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/sortThing" } },
        "items": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/$defs/sortThing" } }
      }
    },
    "sortThing": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "picture": { "$ref": "#/$defs/picture", "description": "Shown instead of the label." },
        "bin": { "type": ["integer", "null"], "description": "Items: index of the bin it goes in." }
      }
    },
    "match": {
      "type": "object",
      "description": "Memory game: cards face down, find the pairs (A and a, a word and its picture). Turning two that are not a pair is not a mistake.",
      "required": ["pairs"],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["a", "b"],
            "additionalProperties": false,
            "properties": { "a": { "$ref": "#/$defs/matchSide" }, "b": { "$ref": "#/$defs/matchSide" } }
          }
        }
      }
    },
    "matchSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": ["string", "null"] },
        "picture": { "$ref": "#/$defs/picture" }
      }
    },
    "pop": {
      "type": "object",
      "description": "Bubble pop: bubbles float up saying the target or one of the others; pop count targets (popping another is a mistake).",
      "required": ["target", "others", "count"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "others": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "count": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "truth": {
      "type": "object",
      "description": "True or silly: a picture and a sentence; tap True or Silly.",
      "required": ["text", "answer"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "picture": { "$ref": "#/$defs/picture" },
        "answer": { "type": "boolean" }
      }
    }
  }
}
