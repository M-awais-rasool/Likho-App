{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likho.app/schema/course.schema.json",
  "title": "Course manifest",
  "description": "courses/<id>/course.json: what the course is. Its worlds and levels are the files next to it.",
  "type": "object",
  "required": ["id", "title", "locale", "status", "schemaVersion", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Same as the folder name. Never change it once published: progress is stored under it." },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "locale": { "type": "string", "description": "Language taught, BCP 47 (en, ur…)." },
    "ages": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": { "min": { "type": "integer", "minimum": 3 }, "max": { "type": "integer", "maximum": 18 } }
    },
    "status": { "enum": ["published", "draft"], "description": "Drafts are served in development only." },
    "schemaVersion": { "const": 1, "description": "Content format version the app must understand." },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
